NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# 画像・ファイルの保存先（Turso）。TURSO_DATABASE_URL は libsql://... のURL
# プロフィールアイコンを含む、すべての画像・ファイルを Turso に保存します
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 仙人アカウントの場所（例: https://account.example.com）。これを入れるだけで、下のURL（認可・トークン・ユーザー情報・ポイント）は
# 仕様どおりの場所（/oauth/authorize ・ /oauth/token ・ /oauth/userinfo ・ /api/v1/me ・ /api/v1/points）に自動で決まります。
# 下の個別のURLを入れた場合は、そちらが優先されます。
SENNIN_BASE_URL=
SENNIN_CLIENT_ID=
SENNIN_CLIENT_SECRET=
# 仙人アカウントの開発者設定に登録したリダイレクトURIと、1文字も違わないこと（末尾のスラッシュ・ポートも）
SENNIN_REDIRECT_URI=http://localhost:3000/api/auth/sennin/callback
SENNIN_AUTHORIZATION_URL=
SENNIN_TOKEN_URL=
SENNIN_USERINFO_URL=
SENNIN_ME_URL=
SENNIN_SCOPE=profile email

# 仙人ストア（ポイントでの購入）。連携のときだけ、次の許可を要求します
# points:write は仙人アカウント側で管理者の承認が必要です（承認されていないと連携画面でエラーになります）
SENNIN_STORE_SCOPE=profile points:read points:write
# 空なら SENNIN_TOKEN_URL と同じサーバーの /api/v1/points・/api/v1/points/adjust を使います
SENNIN_POINTS_URL=
SENNIN_POINTS_ADJUST_URL=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 管理者パネル（/admin/login）のパスワード。空のままなら管理者ログインは使えません
ADMIN_PASSWORD=

# メンテナンスモード。on にすると利用者向けの画面と API を止めて「メンテナンス中」を表示します（管理者パネルと /status は使えます）
# 切り替えはサーバーの再起動（環境変数の変更）で反映されます。空または off で通常どおり
MAINTENANCE_MODE=
# メンテナンス中に表示する文言（空なら既定の文言）
MAINTENANCE_MESSAGE=

# メッセージ本文の暗号化鍵（必須）。32バイトの乱数を base64 にしたもの。
# 作成: openssl rand -base64 32
# ※ 一度設定したら変更しないでください（変えると既存のメッセージが読めなくなります）
MESSAGE_ENCRYPTION_KEY=

# グループ通話の中継サーバー（TURN）。モバイル回線やNATの内側では、これがないと通話がつながらず切れやすくなります。
# 例: turn:turn.example.com:3478,turns:turn.example.com:5349（カンマ区切り）。空なら STUN のみ
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# SenninPay・ストア（v29）
# 運営の仙人アカウントに連携したソラチャットのユーザーID（sc_users.id）。自分の作品を買ったときのポイントの受け取り先
OPERATOR_USER_ID=
# 1 にすると、仙人アカウントでログインした人に初回30ptのログイン特典を付ける（仙人側で points:write の承認が必要）
SENNIN_LOGIN_BONUS=
# ログインで要求する許可（空なら、SENNIN_LOGIN_BONUS に合わせて自動で決める）
SENNIN_LOGIN_SCOPE=

# 友だち招待キャンペーン（on / off。off のときは招待コードを無視します）
REFERRAL_CAMPAIGN=on
