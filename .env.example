NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# 画像・ファイルの保存先（Turso）。TURSO_DATABASE_URL は libsql://... のURL
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

SENNIN_CLIENT_ID=
SENNIN_CLIENT_SECRET=
SENNIN_REDIRECT_URI=http://localhost:3000/api/auth/sennin/callback
SENNIN_AUTHORIZATION_URL=
SENNIN_TOKEN_URL=
SENNIN_USERINFO_URL=
SENNIN_ME_URL=
SENNIN_SCOPE=profile email

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 管理者パネル（/admin/login）のパスワード。空のままなら管理者ログインは使えません
ADMIN_PASSWORD=

# メンテナンスモード。on にすると利用者向けの画面と API を止めて「メンテナンス中」を表示します（管理者パネルと /status は使えます）
# 切り替えはサーバーの再起動（環境変数の変更）で反映されます。空または off で通常どおり
MAINTENANCE_MODE=
# メンテナンス中に表示する文言（空なら既定の文言）
MAINTENANCE_MESSAGE=

# メッセージ本文の暗号化鍵（必須）。32バイトの乱数を base64 にしたもの。
# 作成: openssl rand -base64 32
# ※ 一度設定したら変更しないでください（変えると既存のメッセージが読めなくなります）
MESSAGE_ENCRYPTION_KEY=
